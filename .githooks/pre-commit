#!/bin/sh
set -e

# Local pre-commit hook to auto-format Rust code before committing.
# Usage: make this file executable (chmod +x .githooks/pre-commit) and
# set your repo to use the hooks directory:
#   git config core.hooksPath .githooks
# Then commits will automatically run cargo fmt and stage changes.

echo "Running cargo fmt..."
# Format all Rust workspace crates
cargo fmt --all

# If cargo fmt made changes, add them to the commit so the developer's commit
# contains the formatted code.
git add -A

# Keep the dev-convenience ~/.local/bin/cyberplug copy (installed via
# `install.sh --local-bin`) in sync with what's actually being committed, so
# it can't quietly go stale (e.g. missing a just-added CLI flag) the way
# bin/<arch>/ getting rebuilt without --local-bin let it drift before.
# Only runs if that copy already exists — this never installs it for you.
if [ -x "$HOME/.local/bin/cyberplug" ]; then
  echo "Refreshing ~/.local/bin/cyberplug..."
  ./install.sh --local-bin >/dev/null
  echo "  -> ~/.local/bin/cyberplug is up to date with this commit"
fi

exit 0
